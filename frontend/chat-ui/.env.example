# Base URL of the FastAPI backend exposing /ask and /health.
# Copy this file to `.env` and adjust if the backend runs elsewhere.
BACKEND_URL=http://localhost:8080

# Base URL of the Vue knowledge-graph renderer (Vite dev server), opened from the
# sidebar "Open graph renderer" button.
FRONTEND_URL=http://localhost:5173

# Neo4j connection used only to derive the "Open Neo4j browser" link host. The
# Browser opens on HTTP port 7474. Set NEO4J_BROWSER_URL to override the full URL.
NEO4J_URI=bolt://localhost:7687
# NEO4J_BROWSER_URL=http://localhost:7474/browser/
