# Neo4j connection settings for the knowledge-graph import script.
# Copy this file to `.env` and adjust to match your running Neo4j container.
# These defaults match scripts/start-database.sh (NEO4J_AUTH=neo4j/password).

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
