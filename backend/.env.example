# Neo4j connection settings for the knowledge-graph import script and query API.
# Copy this file to `.env` and adjust to match your running Neo4j container.
# These defaults match scripts/start-database.sh (NEO4J_AUTH=neo4j/password).

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Azure OpenAI settings for the natural-language /ask endpoint.
# These are optional: the /query endpoint works without them, but /ask returns
# HTTP 503 until they are set.
#
# For an Azure AI Foundry / "v1" deployment, use the OpenAI-compatible endpoint
# ending in /openai/v1 (API_VERSION is then ignored). For a classic Azure OpenAI
# resource, use the bare resource URL (https://<resource>.openai.azure.com) and
# set AZURE_OPENAI_API_VERSION.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: pin the temperature used for text-to-Cypher generation for more
# deterministic, reproducible queries (e.g. 0). Leave unset to omit the parameter —
# some models (e.g. certain reasoning models) reject a non-default temperature.
# AZURE_OPENAI_TEMPERATURE=0

# Optional: Azure Application Insights telemetry
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...

# Optional: Logging level for the backend. Can be set to "DEBUG", "INFO", "WARNING", etc.
# LOG_LEVEL=INFO